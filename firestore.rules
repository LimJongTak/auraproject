rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return isSignedIn() && myProfile().role == 'admin'; }
    function isJudgeOrAdmin() {
      return isSignedIn() && (myProfile().role == 'admin' || myProfile().role == 'judge');
    }

    // ---------------- users ----------------
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user';
      allow update: if isSignedIn() && (
                      (request.auth.uid == uid
                       && request.resource.data.role == resource.data.role
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['name', 'phone', 'memberType', 'school', 'department', 'grade', 'studentId']))
                      || isAdmin()
                    );
      allow delete: if false;
    }

    // ---------------- studentId -> email index (login lookup) ----------------
    // Doc ID == studentId/employeeId. `get` (by a specific, already-known
    // studentId) must be publicly readable so the login form can resolve it
    // to an email *before* the user is authenticated. `list` is intentionally
    // NOT public — the app only ever does single-doc `getDoc` lookups here
    // (never a collection query), so allowing `list` would let anyone
    // unauthenticated dump every studentId -> {uid, email} mapping in one
    // request. Uniqueness is enforced implicitly: once a doc exists, only
    // "update" rules apply to further writes (Firestore rules distinguish
    // create/update by prior existence), and update is admin-only — so a
    // second signup/rename can't overwrite it.
    match /studentIdIndex/{studentId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }

    // ---------------- teams (doc ID == invite code) ----------------
    // Teams now belong to exactly one contest (categoryId). "At most one team
    // per contest per user" is enforced by teamMemberships/{uid}_{categoryId}
    // below, not here — a create/join only fully commits if the matching
    // membership doc also validates in the same transaction.
    match /teams/{teamId} {
      function categoryTeamSizeMax(categoryId) {
        let cat = get(/databases/$(database)/documents/categories/$(categoryId)).data;
        return !('teamSizeMax' in cat) ? null : cat.teamSizeMax;
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.leaderUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid]
                    && request.resource.data.categoryId is string;
      allow update: if isSignedIn() && (
                      (request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
                       && (categoryTeamSizeMax(resource.data.categoryId) == null
                           || request.resource.data.memberUids.size() <= categoryTeamSizeMax(resource.data.categoryId)))
                      || (request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
                          && resource.data.leaderUid != request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']))
                      || isAdmin()
                    );
      allow delete: if (isSignedIn() && resource.data.leaderUid == request.auth.uid
                         && resource.data.memberUids.size() == 1) || isAdmin();
    }

    // ---------------- team memberships (doc ID == `${uid}_${categoryId}`) ----------------
    match /teamMemberships/{membershipId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && membershipId == request.auth.uid + '_' + request.resource.data.categoryId;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---------------- categories ----------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- visit stats (anonymous visitor counter) ----------------
    // One doc per calendar day, doc ID == date. Anyone visiting the site can
    // bump today's count by exactly 1; only admins can read the aggregated
    // history (via the analytics dashboard).
    match /visitStats/{date} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.count == 1
                    && request.resource.data.keys().hasOnly(['count', 'updatedAt']);
      allow update: if request.resource.data.count == resource.data.count + 1
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']);
      allow delete: if false;
    }

    // ---------------- announcements ----------------
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- quick links (floating external-link menu) ----------------
    match /quickLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- inquiries (student -> admin) ----------------
    match /inquiries/{inquiryId} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // Non-admin queries must filter where('uid','==', myUid) themselves —
      // same "provably true per result" pattern as exhibitions below.
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.answer == null;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'answeredAt', 'answeredBy'])
        && request.resource.data.status == 'answered';
      allow delete: if isAdmin();
    }

    // ---------------- mileage grants (admin -> student ledger) ----------------
    // Unlike inquiries, students never create their own grant docs — only an
    // admin can create/update/delete. get/list stay owner-or-admin so a
    // student's own MyPage mileage tab can query where('uid','==', myUid).
    match /mileageGrants/{grantId} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------- per-category banner theme reveal ----------------
    match /bannerThemes/{categoryId} {
      // The reveal time itself lives on the (public) category doc, not here —
      // only the theme content is gated. Public visitors only get it once
      // Firestore's own server clock passes that time (client clock tampering
      // can't bypass this). Admins can always read/preview regardless.
      allow read: if isAdmin()
        || request.time >= get(/databases/$(database)/documents/categories/$(categoryId)).data.themeRevealAt;
      allow write: if isAdmin();
    }

    // ---------------- exhibitions ----------------
    match /exhibitions/{exhibitionId} {
      function isWithinSubmissionWindow(categoryId) {
        let cat = get(/databases/$(database)/documents/categories/$(categoryId)).data;
        return request.time >= cat.submissionOpenAt && request.time <= cat.submissionCloseAt;
      }

      // Teams are scoped to one contest each (see teams/{teamId}), so "is this
      // caller on the team submitting/owning this exhibition" is just "does
      // their membership for this exhibition's contest point at this team".
      function myMembershipTeamId(categoryId) {
        return get(/databases/$(database)/documents/teamMemberships/$(request.auth.uid + '_' + categoryId)).data.teamId;
      }

      // Defense in depth — the cap is already enforced when joining a team
      // (see teams/{teamId} allow update), this just covers pre-existing teams.
      function isTeamSizeAllowed(categoryId, teamId) {
        let cat = get(/databases/$(database)/documents/categories/$(categoryId)).data;
        let team = get(/databases/$(database)/documents/teams/$(teamId)).data;
        let size = team.memberUids.size();
        let minOk = !('teamSizeMin' in cat) || size >= cat.teamSizeMin;
        let maxOk = !('teamSizeMax' in cat) || cat.teamSizeMax == null || size <= cat.teamSizeMax;
        return minOk && maxOk;
      }

      // Applies to both single-doc get() and list() queries. For list(), Firestore
      // requires the query's own where()/orderBy() filters to make one whole branch
      // provably true for every possible result — e.g. the public gallery query must
      // filter where('status','==','published'); a team's own query filters
      // where('teamId','==', myTeamId); admin queries (isAdmin() doesn't depend on
      // resource.data) can be unfiltered. An unfiltered, non-admin query against this
      // collection will be rejected outright rather than silently partially-filtered.
      allow read: if resource.data.status == 'published'
                 || isAdmin()
                 || (isSignedIn() && myMembershipTeamId(resource.data.categoryId) == resource.data.teamId);

      allow create: if isSignedIn()
        && myMembershipTeamId(request.resource.data.categoryId) == request.resource.data.teamId
        && request.resource.data.status == 'draft'
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && isWithinSubmissionWindow(request.resource.data.categoryId)
        && isTeamSizeAllowed(request.resource.data.categoryId, request.resource.data.teamId);

      allow update: if isSignedIn() && (
          (myMembershipTeamId(resource.data.categoryId) == resource.data.teamId
           && resource.data.status == 'draft'
           && request.resource.data.status == 'published'
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'pageImageUrls', 'pageCount', 'thumbnailUrl', 'updatedAt']))
          || (myMembershipTeamId(resource.data.categoryId) == resource.data.teamId
              && isWithinSubmissionWindow(resource.data.categoryId)
              && request.resource.data.likeCount == resource.data.likeCount
              && request.resource.data.commentCount == resource.data.commentCount
              && request.resource.data.teamId == resource.data.teamId
              && request.resource.data.status == resource.data.status)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
              && (request.resource.data.likeCount == resource.data.likeCount + 1
                  || request.resource.data.likeCount == resource.data.likeCount - 1))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
              && (request.resource.data.commentCount == resource.data.commentCount + 1
                  || request.resource.data.commentCount == resource.data.commentCount - 1))
          || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['award']))
      );
      allow delete: if isAdmin()
        || (isSignedIn() && myMembershipTeamId(resource.data.categoryId) == resource.data.teamId);

      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn()
          && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // ---------------- evaluations (doc ID == `${judgeUid}_${exhibitionId}`) ----------------
    // Judges and admins only — students must never be able to read scores.
    match /evaluations/{evalId} {
      allow get, list: if isJudgeOrAdmin();
      allow create: if isJudgeOrAdmin()
        && request.resource.data.judgeUid == request.auth.uid
        && evalId == request.auth.uid + '_' + request.resource.data.exhibitionId;
      allow update: if isJudgeOrAdmin()
        && resource.data.judgeUid == request.auth.uid
        && request.resource.data.judgeUid == resource.data.judgeUid
        && request.resource.data.exhibitionId == resource.data.exhibitionId
        && request.resource.data.categoryId == resource.data.categoryId;
      allow delete: if isAdmin();
    }
  }
}
