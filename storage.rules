rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Team membership isn't stored on the user profile — it lives in
    // teamMemberships/{uid}_{categoryId}, one doc per contest a user has
    // joined (mirrors myMembershipTeamId() in firestore.rules).
    //
    // get().data on a teamMemberships doc that doesn't exist (e.g. an admin,
    // who never joins a team, replacing another team's PDF/thumbnail) throws
    // rather than just failing the equality check below — so this must
    // exists()-guard it first, or "isTeamMemberOf(...) || isAdmin()" denies
    // the admin branch too whenever the error isn't absorbed by the OR.
    function isTeamMemberOf(exhibitionId) {
      let ex = firestore.get(/databases/(default)/documents/exhibitions/$(exhibitionId)).data;
      let membershipPath = /databases/(default)/documents/teamMemberships/$(request.auth.uid + '_' + ex.categoryId);
      return isSignedIn() && firestore.exists(membershipPath) && firestore.get(membershipPath).data.teamId == ex.teamId;
    }

    // isAdmin() is checked with `? true :` rather than `|| isAdmin()` on
    // purpose — a plain `isTeamMemberOf(...) || isAdmin()` still relies on an
    // admin-caused error inside isTeamMemberOf() (no teamMemberships doc,
    // since admins never join a team) being silently absorbed by the OR, and
    // that didn't reliably happen here even after guarding the missing-doc
    // case with firestore.exists(). The ternary is a real short-circuit —
    // isTeamMemberOf() is never invoked at all once isAdmin() is true, so it
    // can't matter whether it would have errored.
    match /exhibitions/{exhibitionId}/pages/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (isAdmin() ? true : isTeamMemberOf(exhibitionId))
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|webp|png)');
    }
    match /exhibitions/{exhibitionId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (isAdmin() ? true : isTeamMemberOf(exhibitionId))
                   && fileName.matches('thumbnail(-manual)?[.].+')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|webp|png)');
    }
    match /config/theme/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /announcements/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
