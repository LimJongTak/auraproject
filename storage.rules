rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Team membership isn't stored on the user profile — it lives in
    // teamMemberships/{uid}_{categoryId}, one doc per contest a user has
    // joined (mirrors myMembershipTeamId() in firestore.rules).
    function isTeamMemberOf(exhibitionId) {
      let ex = firestore.get(/databases/(default)/documents/exhibitions/$(exhibitionId)).data;
      let membership = firestore.get(/databases/(default)/documents/teamMemberships/$(request.auth.uid + '_' + ex.categoryId)).data;
      return isSignedIn() && membership.teamId == ex.teamId;
    }

    match /exhibitions/{exhibitionId}/pages/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (isTeamMemberOf(exhibitionId) || isAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|webp|png)');
    }
    match /exhibitions/{exhibitionId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (isTeamMemberOf(exhibitionId) || isAdmin())
                   && fileName.matches('thumbnail(-manual)?[.].+')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|webp|png)');
    }
    match /config/theme/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /announcements/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
